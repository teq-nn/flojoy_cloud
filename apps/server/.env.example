GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
NODE_ENV=development

# The exact origin (scheme + host[:port]) that serves the SPA
# For local dev via Vite: http://localhost:5173
# For dockerized nginx on the same host (port 80): http://localhost
# For LAN deployment: e.g. http://192.168.1.20
WEB_URI=http://localhost:5173

JWT_SECRET=
